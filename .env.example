# StayPulse — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored and must never be committed.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database — Supabase PostgreSQL (Shared Pooler, Session mode, port 5432)
# ---------------------------------------------------------------------------
# Provide EITHER the discrete parameters below (PREFERRED) or a single DATABASE_URL.
#
# Discrete parameters are preferred because they are immune to the URI-encoding
# problem: a password containing ?, #, @, /, : or & will silently corrupt a URI
# unless percent-encoded. With discrete vars you paste the password verbatim and
# the application encodes it correctly for you.
PGHOST=aws-0-<region>.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<your-project-ref>
PGPASSWORD=paste-your-password-verbatim-here-no-encoding-needed

# Optional single-URI alternative. If set, this WINS over the discrete vars above.
# If your password contains special characters they MUST be percent-encoded here
# (? -> %3F, # -> %23, @ -> %40, / -> %2F, : -> %3A, & -> %26).
# Leave blank to use the discrete parameters.
DATABASE_URL=

# ---------------------------------------------------------------------------
# LLM — Google Gemini (application runtime model)
# ---------------------------------------------------------------------------
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# External context — OpenWeather (OPTIONAL)
# ---------------------------------------------------------------------------
# Only wired in if the analysis shows a defensible business use case.
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Not used. Listed so it is explicit that they are deliberately absent.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY  -> not used. Claude is the development assistant only;
#                       the application runtime LLM is Gemini.
# SUPABASE_ANON_KEY  -> not used. Supabase is used purely as hosted PostgreSQL,
#                       not as a BaaS/CRUD API.
